    "_postman_id": "finco-full-crud-collection",
    "name": "FinCo - API REST (Tiers, Plan Comptable, Centres de Coûts)",
    "description": "Collection Postman pour tester l'authentification et les trois CRUD complets de FinCo (Tiers, Plan comptable, Centres de coûts).",
