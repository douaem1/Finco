  "item": [
    {
      "name": "0-Authentification",
      "item": [
        {
          "name": "1. Login - Comptable",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Code HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test('Jeton OTP généré', function () {",
                  "    pm.expect(data.jetonOtp).to.be.a('string');",
                  "});",
                  "pm.environment.set('jetonOtp', data.jetonOtp);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailComptable}}\",\n  \"motDePasse\": \"{{motDePasseComptable}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "2. Vérifier OTP - Comptable",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Code HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test('JWT et rôle COMPTABLE retournés', function () {",
                  "    pm.expect(data.token).to.be.a('string');",
                  "    pm.expect(data.utilisateur.role).to.eql('COMPTABLE');",
                  "});",
                  "pm.environment.set('tokenComptable', data.token);"
